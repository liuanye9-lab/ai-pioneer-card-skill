# ==== Feishu / Lark Open Platform Credentials ====
# 复制为 .env 并填写真实值。切勿提交 .env 到 Git。
# 未配置时 Skill 仍可生成全部离线产物（状态：Generated）。

# 应用凭证（Server API）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 事件订阅 / 卡片回调校验
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# 可选：飞书开放平台域名（默认国内版 open.feishu.cn；Lark 国际版填 open.larksuite.com）
FEISHU_BASE_URL=https://open.feishu.cn

# 可选：默认发送目标（chat_id / open_id），仅在真实发送测试时使用
FEISHU_DEFAULT_CHAT_ID=

# 可选：外部文生图服务（图片仅规划 Prompt，不强制生成中文）
IMAGE_PROVIDER_BASE_URL=
IMAGE_PROVIDER_API_KEY=

# HTTP 工具服务（部署到公网时必须配置强随机值）
TOOL_SERVER_TOKEN=
TOOL_PORT=3100
TOOL_MAX_BODY_BYTES=1000000

# 卡片回调服务端口
CALLBACK_PORT=3000
